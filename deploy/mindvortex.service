[Unit]
Description=Mind Vortex Next.js
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mindvortex
Group=mindvortex
WorkingDirectory=/opt/mindvortex/current
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3001
Environment=PROSPECTING_TRUST_PROXY=true
Environment=PROSPECTING_DATA_DIR=/var/lib/mindvortex-prospecting
EnvironmentFile=/etc/mindvortex.env
EnvironmentFile=-/etc/mindvortex-prospecting.env
ExecStart=/opt/node-mindvortex/bin/node server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=mindvortex-prospecting
ReadWritePaths=-/opt/mindvortex/current/.next/cache
UMask=0077

[Install]
WantedBy=multi-user.target
