[Unit]
Description=Mind Vortex Next.js
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mindvortex
Group=mindvortex
WorkingDirectory=/opt/mindvortex/current
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3001
EnvironmentFile=/etc/mindvortex.env
ExecStart=/opt/node-mindvortex/bin/node server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/mindvortex

[Install]
WantedBy=multi-user.target
