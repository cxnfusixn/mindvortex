[Unit]
Description=MindVortex prospecting worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mindvortex
Group=mindvortex
WorkingDirectory=/opt/mindvortex/current
Environment=NODE_ENV=production
Environment=PROSPECTING_RETENTION_ENABLED=true
Environment=PROSPECTING_DATA_DIR=/var/lib/mindvortex-prospecting
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/mindvortex/browsers
EnvironmentFile=/etc/mindvortex.env
EnvironmentFile=/etc/mindvortex-prospecting.env
ExecStart=/opt/node-mindvortex/bin/node ../../prospecting/worker.mjs
Restart=on-failure
RestartSec=15
TimeoutStopSec=300
KillSignal=SIGTERM
StateDirectory=mindvortex-prospecting
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077
MemoryMax=2G
TasksMax=256

[Install]
WantedBy=multi-user.target
