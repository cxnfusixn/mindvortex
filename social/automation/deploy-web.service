[Unit]
Description=Mind Vortex Social dashboard
After=network-online.target postgresql.service
[Service]
User=mv-social
Group=mv-social
WorkingDirectory=/opt/mindvortex-social/current
Environment=NODE_ENV=production
EnvironmentFile=/etc/mindvortex-social.env
ExecStart=/opt/node-mindvortex/bin/node node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3020
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/mindvortex-social
UMask=0077
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
PrivateDevices=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=1G
TasksMax=128
ProtectHome=true
[Install]
WantedBy=multi-user.target
